# Kiss Application Environment Variables
# Copy this file to .env and fill in actual values.
# DO NOT commit the .env file to version control.

# ============================================================
# Database Configuration (used by docker-compose and deploy.sh)
# ============================================================

# PostgreSQL database name
DB_NAME=kissdb

# PostgreSQL database user
DB_USER=kiss

# PostgreSQL database password (CHANGE THIS in production!)
DB_PASSWORD=changeme

# PostgreSQL host (use 'db' for docker-compose, 'localhost' for bare metal)
DB_HOST=db

# PostgreSQL port
DB_PORT=5432

# ============================================================
# Application Configuration
# ============================================================

# Deployment environment: dev, test, or prod
KISS_ENV=dev

# JVM memory settings
JAVA_OPTS=-Xms256m -Xmx512m

# Application HTTP port
APP_PORT=8080
