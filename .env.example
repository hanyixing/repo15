# Copy this file to .env and adjust the values.  Consumed by docker-compose.yml.
# The real .env is gitignored so credentials never reach version control.
#
# These three values configure the Postgres container AND are passed through
# to the Kiss web container as DATABASE_NAME / DATABASE_USER / DATABASE_PASSWORD.
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
